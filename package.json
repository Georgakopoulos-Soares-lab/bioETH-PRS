{
  "name": "bioeth-prs",
  "version": "0.1.0",
  "private": true,
  "description": "bioETH PRS — High-performance confidential GWAS PRS prototype on Ethereum/fhEVM.",
  "scripts": {
    "advisor:quantization": "ts-node scripts/quantization_advisor.ts",
    "advisor:scale-ceilings": "ts-node scripts/scale_ceiling_reference.ts",
    "build": "hardhat compile",
    "profile:heprs": "node -r ts-node/register -r hardhat/register scripts/heprs_fixture_profile.ts",
    "test": "hardhat test",
    "profile:gas": "hardhat run scripts/gas_profile.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@swc/core": "^1.15.18",
    "hardhat": "^2.22.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "fhevmjs": "^0.6.2"
  }
}
